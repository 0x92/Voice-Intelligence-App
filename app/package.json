{
  "name": "voice-intelligence",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"next dev -p 3000\" \"wait-on tcp:3000 && cross-env ELECTRON_RENDERER_URL=http://localhost:3000 node electron/launch.js\"",
    "dev:next": "next dev -p 3000",
    "dev:electron": "wait-on tcp:3000 && cross-env ELECTRON_RENDERER_URL=http://localhost:3000 node electron/launch.js",
    "build": "next build",
    "build:electron": "electron-builder",
    "start": "node electron/launch.js",
    "lint": "eslint"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "next": "16.1.6",
    "openai": "^4.83.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^32.2.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "wait-on": "^7.2.0",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.voiceintelligence.app",
    "productName": "Voice Intelligence",
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ]
  }
}
